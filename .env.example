# Copy to .env (git-ignored) and fill in. Never commit real keys or tunnel URLs.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# EXTRACTOR=auto            # auto | gemini | claude | keyword
# GEMINI_MODEL=gemini-3.5-flash
# CORS_ORIGINS=*            # comma-separated origins, e.g. https://yourapp.lovable.app
# API_ACCESS_TOKEN=         # if set, AI endpoints require header X-API-Key: <token>
# AI_RATE_LIMIT_PER_MIN=10  # per client on AI endpoints; 0 disables
# PUBLIC_API_URL=           # your ngrok/deployed URL (kept here, not in git)
